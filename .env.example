# Uso local fora de Docker. Dentro do Compose, configure um hostname acessível na rede Docker.
# Com replica set (necessário para administrar acessos), a descoberta de topologia devolve o hostname
# do membro: acrescente directConnection=true para os scripts no host continuarem alcançando o banco
# (ex.: mongodb://usuario:senha@127.0.0.1:27017/shekinah?authSource=admin&directConnection=true).
# APP_ORIGIN precisa ser exatamente a origem do navegador (sem barra final); use o IP/domínio
# pelo qual a interface será acessada, não apenas localhost.
MONGODB_URI=mongodb://127.0.0.1:27017/shekinah
AUTH_SECRET=
# Apenas infraestrutura de criptografia. Gere com: openssl rand -base64 32
# Guarde backup: trocar esta chave torna os segredos salvos ilegíveis.
INTEGRATIONS_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:5180
API_PORT=3010
ADMIN_PORT=5180
# Porta web publicada em 0.0.0.0 pelo Compose. Tem precedência sobre ADMIN_PORT e é a mesma
# porta do servidor de desenvolvimento do admin; reservas de prévia usam a faixa 7001–7098.
PORT=5180
API_PROXY_TARGET=http://127.0.0.1:3010
SESSION_MAX_AGE_SECONDS=28800
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MS=900000
NODE_ENV=development
LOG_LEVEL=info
# Compose (opcionais):
# MONGODB_NETWORK=mongodb-network
# APP_VERSION=0.1.0
